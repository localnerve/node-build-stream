{
  "name": "node-build-stream-bench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Performance benchmark for node-build-stream vs gulp, using the examples/webapp pipeline as the workload. Results accumulate in results/history.jsonl for over-time tracking.",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bench": "node src/index.ts",
    "gate": "node src/index.ts --gate 3",
    "report": "node src/index.ts --report",
    "test": "node --test \"src/lib/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "autoprefixer": "^10.6.2",
    "gulp": "^5.0.1",
    "handlebars": "^4.7.10",
    "postcss": "^8.5.32",
    "rollup": "^4.68.3",
    "sass": "^1.108.2",
    "sitemap": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "~7.0.2"
  }
}
